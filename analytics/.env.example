# Phase 0
LOG_LEVEL=INFO

# Phase 1: video processing
# Keep 1 out of every N frames when extracting from a video.
VIDEO_SAMPLE_RATE=5

# Resize extracted frames to this width in pixels (aspect ratio preserved).
# Set to 0 to disable resizing.
FRAME_RESIZE_WIDTH=640

RAW_VIDEO_DIR=data/raw
PROCESSED_FRAMES_DIR=data/processed

# Phase 9: AI Football Analyst (Google Gemini)
# Create a key in Google AI Studio - required for scripts/ask_analyst.py
GEMINI_API_KEY=
LLM_MODEL=gemini-3-flash-preview
